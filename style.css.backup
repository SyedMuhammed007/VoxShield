/* ==========================================================================
   VoxShield — Cyber Defense Design System & High-Tech UI
   Aesthetic: Premium Dark Cyberpunk / Enterprise Fintech Security
   ========================================================================== */

:root {
    --bg-dark: #070a12;
    --bg-card: #0d1322;
    --bg-card-hover: #141d33;
    --bg-surface: #10192e;
    --bg-surface-glass: rgba(16, 25, 46, 0.75);

    --border-subtle: rgba(255, 255, 255, 0.08);
    --border-accent: rgba(5, 245, 161, 0.25);
    --border-glow: 0 0 16px rgba(5, 245, 161, 0.2);

    --text-main: #f1f5f9;
    --text-muted: #94a3b8;
    --text-dim: #64748b;

    --accent-emerald: #05f5a1;
    --accent-emerald-glow: rgba(5, 245, 161, 0.4);
    --accent-cyan: #0ea5e9;
    --accent-cyan-glow: rgba(14, 165, 233, 0.4);
    --accent-amber: #f59e0b;
    --accent-amber-glow: rgba(245, 158, 11, 0.4);
    --accent-red: #ff2a55;
    --accent-red-glow: rgba(255, 42, 85, 0.4);

    --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-mono: 'JetBrains Mono', monospace;
    --radius-sm: 6px;
    --radius-md: 12px;
    --radius-lg: 20px;
    --radius-phone: 46px;
    --transition-fast: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-smooth: 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

*, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background-color: var(--bg-dark);
    background-image: 
        radial-gradient(circle at 20% 15%, rgba(14, 165, 233, 0.08) 0%, transparent 40%),
        radial-gradient(circle at 80% 80%, rgba(5, 245, 161, 0.06) 0%, transparent 50%),
        linear-gradient(to bottom, #05080e 0%, #070a12 100%);
    color: var(--text-main);
    font-family: var(--font-sans);
    line-height: 1.5;
    min-height: 100vh;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
}

/* --- Container Shell --- */
.vox-container {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    max-width: 1720px;
    margin: 0 auto;
    padding: 16px 24px;
}

/* --- Top Navigation Bar --- */
.vox-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--bg-surface-glass);
    backdrop-filter: blur(20px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 12px 24px;
    margin-bottom: 20px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.36);
}

.header-brand {
    display: flex;
    align-items: center;
    gap: 14px;
}

.shield-logo {
    position: relative;
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, rgba(5, 245, 161, 0.2), rgba(14, 165, 233, 0.2));
    border: 1px solid var(--accent-emerald);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 16px rgba(5, 245, 161, 0.3);
}

.shield-icon {
    font-size: 22px;
}

.pulse-ring {
    position: absolute;
    inset: -3px;
    border-radius: 14px;
    border: 1px solid var(--accent-emerald);
    opacity: 0.6;
    animation: pulseRing 2.4s infinite;
}

@keyframes pulseRing {
    0% { transform: scale(1); opacity: 0.8; }
    50% { transform: scale(1.12); opacity: 0; }
    100% { transform: scale(1); opacity: 0; }
}

.brand-text .brand-title {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    background: linear-gradient(90deg, #ffffff, var(--accent-emerald));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.brand-text .brand-subtitle {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 1px;
    color: var(--text-dim);
}

.header-telemetry {
    display: flex;
    align-items: center;
    gap: 16px;
}

.status-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: 9999px;
    background: rgba(13, 19, 34, 0.8);
    border: 1px solid var(--border-subtle);
    letter-spacing: 0.5px;
}

.status-pill.security-armed {
    border-color: rgba(5, 245, 161, 0.4);
    color: var(--accent-emerald);
    box-shadow: 0 0 12px rgba(5, 245, 161, 0.15);
}

.status-pill.online {
    border-color: rgba(14, 165, 233, 0.4);
    color: var(--accent-cyan);
}

.status-pill.offline {
    border-color: rgba(148, 163, 184, 0.3);
    color: var(--text-muted);
}

.dot-blink {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
}

.dot-blink.green {
    background-color: var(--accent-emerald);
    box-shadow: 0 0 8px var(--accent-emerald);
    animation: blink 1.6s infinite;
}

@keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
}

.volume-control-box {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(0, 0, 0, 0.3);
    padding: 4px 12px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    font-size: 0.8rem;
    color: var(--text-muted);
}

.volume-control-box input[type="range"] {
    width: 80px;
    accent-color: var(--accent-emerald);
    cursor: pointer;
}

/* --- Push Alert Banner (Simulated Native Device Notification) --- */
.push-alert-banner {
    display: flex;
    align-items: center;
    gap: 16px;
    background: linear-gradient(90deg, #1b1016, #2d121c, #161022);
    border: 1.5px solid var(--accent-red);
    border-radius: var(--radius-md);
    padding: 14px 20px;
    margin-bottom: 20px;
    box-shadow: 0 8px 30px rgba(255, 42, 85, 0.35);
    animation: slideDownAlert 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.push-alert-banner.hidden {
    display: none;
}

@keyframes slideDownAlert {
    from { transform: translateY(-20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
}

.push-alert-icon {
    font-size: 28px;
    animation: ringBell 0.6s infinite alternate;
}

@keyframes ringBell {
    from { transform: rotate(-12deg); }
    to { transform: rotate(12deg); }
}

.push-alert-content {
    flex: 1;
}

.push-title {
    font-weight: 700;
    color: #ff85a1;
    font-size: 0.95rem;
}

.push-desc {
    font-size: 0.88rem;
    color: var(--text-main);
    margin-top: 2px;
}

.push-meta {
    font-size: 0.72rem;
    color: var(--text-dim);
    margin-top: 2px;
    font-family: var(--font-mono);
}

.push-actions {
    display: flex;
    gap: 10px;
}

/* --- Buttons System --- */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 9px 18px;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.86rem;
    cursor: pointer;
    border: 1px solid transparent;
    transition: all var(--transition-fast);
    font-family: var(--font-sans);
}

.btn-sm {
    padding: 6px 12px;
    font-size: 0.78rem;
}

.btn-primary {
    background: linear-gradient(135deg, #05f5a1, #0ea5e9);
    color: #070a12;
    box-shadow: 0 4px 16px rgba(5, 245, 161, 0.3);
}

.btn-primary:hover {
    box-shadow: 0 6px 20px rgba(5, 245, 161, 0.5);
    transform: translateY(-1px);
}

.btn-success {
    background: #10b981;
    color: #ffffff;
}

.btn-success:hover {
    background: #059669;
}

.btn-danger {
    background: var(--accent-red);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(255, 42, 85, 0.4);
}

.btn-danger:hover {
    background: #e11d48;
}

.btn-outline {
    background: transparent;
    border-color: var(--border-accent);
    color: var(--accent-emerald);
}

.btn-outline:hover {
    background: rgba(5, 245, 161, 0.1);
}

.btn-ghost {
    background: transparent;
    border-color: var(--border-subtle);
    color: var(--text-muted);
}

.btn-ghost:hover {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-main);
}

/* ==========================================================================
   Workspace Layout (Dual-View: Phone Simulator + SOC Command Console)
   ========================================================================== */
.app-workspace {
    display: grid;
    grid-template-columns: 460px 1fr;
    gap: 28px;
    align-items: start;
    flex: 1;
}

.app-workspace.mobile-only-mode {
    grid-template-columns: 460px;
    justify-content: center;
}

.app-workspace.mobile-only-mode .soc-dashboard-wrapper {
    display: none;
}

/* --- Realistic Smartphone Frame --- */
.mobile-device-wrapper {
    display: flex;
    justify-content: center;
}

.mobile-device {
    position: relative;
    width: 410px;
    height: 820px;
    background: #090e1a;
    border: 11px solid #1c273e;
    border-radius: var(--radius-phone);
    box-shadow: 
        0 0 0 2px #0a1120,
        0 20px 50px rgba(0, 0, 0, 0.8),
        0 0 35px rgba(5, 245, 161, 0.12);
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

/* Phone Glass Glare Effect */
.mobile-device::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 40%;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.04) 0%, transparent 60%);
    pointer-events: none;
    z-index: 100;
}

/* Dynamic Island / Speaker Notch */
.mobile-notch {
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    width: 124px;
    height: 26px;
    background: #000000;
    border-radius: 20px;
    z-index: 90;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 14px;
}

.notch-camera {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #111a2e;
    box-shadow: inset 0 0 3px #05f5a1;
}

.notch-speaker {
    width: 44px;
    height: 4px;
    border-radius: 2px;
    background: #1e293b;
}

/* Phone Status Bar */
.mobile-status-bar {
    padding: 14px 22px 4px 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-muted);
    font-family: var(--font-sans);
    z-index: 80;
}

.mobile-status-bar .bar-icons {
    display: flex;
    gap: 6px;
    font-size: 0.68rem;
}

/* Mobile Screen Container */
.mobile-screen {
    display: none;
    flex: 1;
    overflow-y: auto;
    padding: 12px 18px 70px 18px;
    scroll-behavior: smooth;
}

.mobile-screen.active {
    display: block;
    animation: fadeInScreen 0.25s ease-out;
}

@keyframes fadeInScreen {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
}

/* Screen Content Styles */
.shield-hero-card {
    background: linear-gradient(145deg, rgba(16, 25, 46, 0.9), rgba(9, 14, 26, 0.95));
    border: 1px solid var(--border-accent);
    border-radius: var(--radius-md);
    padding: 16px;
    text-align: center;
    margin-bottom: 16px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
}

.hero-shield-glow {
    font-size: 40px;
    margin-bottom: 4px;
    animation: floatGlow 3s infinite ease-in-out;
}

@keyframes floatGlow {
    0%, 100% { transform: translateY(0); filter: drop-shadow(0 0 8px var(--accent-emerald-glow)); }
    50% { transform: translateY(-4px); filter: drop-shadow(0 0 16px var(--accent-emerald-glow)); }
}

.shield-hero-card h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-main);
}

.shield-hero-card p {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin: 4px 0 10px 0;
}

.protection-pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
}

.pill-mini {
    background: rgba(5, 245, 161, 0.12);
    border: 1px solid rgba(5, 245, 161, 0.3);
    color: var(--accent-emerald);
    font-size: 0.66rem;
    padding: 3px 8px;
    border-radius: 999px;
    font-weight: 600;
}

.section-title-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 14px 0 10px 0;
}

.section-title-bar h4 {
    font-size: 0.84rem;
    color: var(--text-muted);
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}

.tag-sih {
    background: rgba(14, 165, 233, 0.2);
    color: var(--accent-cyan);
    font-size: 0.65rem;
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 700;
}

/* Call Scenario Cards */
.scenarios-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.scenario-card {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 10px 12px;
    cursor: pointer;
    transition: all var(--transition-fast);
}

.scenario-card:hover {
    background: var(--bg-card-hover);
    border-color: rgba(255, 255, 255, 0.15);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.4);
}

.scenario-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--bg-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    border: 1px solid var(--border-subtle);
}

.scenario-info {
    flex: 1;
}

.sc-title {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-main);
}

.sc-desc {
    font-size: 0.7rem;
    color: var(--text-dim);
}

.sc-badge {
    font-size: 0.68rem;
    font-weight: 600;
    margin-top: 2px;
}

.text-green { color: var(--accent-emerald); }
.text-red { color: var(--accent-red); }
.text-yellow { color: var(--accent-amber); }
.text-cyan { color: var(--accent-cyan); }

.btn-call-icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #10b981;
    border: none;
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    box-shadow: 0 2px 10px rgba(16, 185, 129, 0.4);
    transition: transform var(--transition-fast);
}

.btn-call-icon.alert {
    background: var(--accent-red);
    box-shadow: 0 2px 10px rgba(255, 42, 85, 0.4);
}

.btn-call-icon.mic {
    background: var(--accent-cyan);
    box-shadow: 0 2px 10px rgba(14, 165, 233, 0.4);
}

.scenario-card:hover .btn-call-icon {
    transform: scale(1.1);
}

.dpdp-banner {
    margin-top: 14px;
    background: rgba(14, 165, 233, 0.08);
    border: 1px dashed rgba(14, 165, 233, 0.3);
    border-radius: var(--radius-sm);
    padding: 8px 12px;
    text-align: center;
    font-size: 0.72rem;
    color: var(--accent-cyan);
}

.dpdp-banner small {
    display: block;
    color: var(--text-dim);
    font-size: 0.65rem;
    margin-top: 2px;
}

/* ==========================================================================
   Screen 2: Live In-Call Protection Screen
   ========================================================================== */
.in-call-view {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.call-top-header {
    text-align: center;
    padding: 6px 0 2px 0;
}

.caller-avatar-large {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #111a2e;
    border: 2px solid var(--accent-emerald);
    margin: 0 auto 6px auto;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
    transition: all 0.4s ease;
}

.caller-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-main);
}

.caller-phone {
    font-size: 0.75rem;
    color: var(--text-dim);
    font-family: var(--font-mono);
}

.call-timer-display {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    color: var(--accent-emerald);
    margin-top: 2px;
}

/* Waveform Box */
.waveform-box {
    background: #040810;
    border: 1px solid rgba(5, 245, 161, 0.25);
    border-radius: var(--radius-sm);
    padding: 6px 8px;
    text-align: center;
}

.waveform-box canvas {
    width: 100%;
    height: 48px;
    display: block;
}

.waveform-label {
    font-size: 0.6rem;
    color: var(--text-dim);
    font-family: var(--font-mono);
    letter-spacing: 0.5px;
    margin-top: 2px;
}

/* 5 Live Indicators Grid */
.indicators-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
}

.indicator-item {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 8px;
}

.indicator-item.full-width {
    grid-column: span 2;
}

.indicator-label {
    font-size: 0.62rem;
    font-weight: 700;
    color: var(--text-dim);
    letter-spacing: 0.5px;
    text-transform: uppercase;
}

.indicator-val {
    font-size: 0.76rem;
    font-weight: 700;
    font-family: var(--font-mono);
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.status-green { color: var(--accent-emerald); }
.status-red { color: var(--accent-red); }
.status-yellow { color: var(--accent-amber); }

.animate-pulse {
    animation: statusPulse 1.2s infinite;
}

@keyframes statusPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.45; }
}

/* Decision Banner */
.decision-banner {
    border-radius: var(--radius-sm);
    padding: 10px 12px;
    border: 1px solid transparent;
    transition: all 0.3s ease;
}

.banner-green {
    background: rgba(5, 245, 161, 0.12);
    border-color: rgba(5, 245, 161, 0.4);
    color: var(--accent-emerald);
}

.banner-yellow {
    background: rgba(245, 158, 11, 0.15);
    border-color: rgba(245, 158, 11, 0.4);
    color: var(--accent-amber);
}

.banner-red {
    background: rgba(255, 42, 85, 0.18);
    border-color: var(--accent-red);
    color: #ff85a1;
    box-shadow: 0 0 20px rgba(255, 42, 85, 0.3);
}

.decision-tag {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    opacity: 0.8;
}

.decision-headline {
    font-size: 0.95rem;
    font-weight: 800;
    margin-top: 1px;
}

.decision-sub {
    font-size: 0.72rem;
    color: var(--text-main);
    margin-top: 2px;
}

/* Transcript Stream */
.transcript-wrapper {
    background: #050a14;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    overflow: hidden;
}

.transcript-header {
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid var(--border-subtle);
    padding: 4px 10px;
    display: flex;
    justify-content: space-between;
    font-size: 0.62rem;
    font-weight: 700;
    color: var(--text-dim);
    letter-spacing: 0.5px;
}

.transcript-stream {
    height: 95px;
    overflow-y: auto;
    padding: 8px 10px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.74rem;
}

.transcript-msg.system-note {
    color: var(--text-dim);
    font-style: italic;
    font-size: 0.7rem;
}

.transcript-msg.caller-line {
    color: var(--text-main);
}

.transcript-msg .time {
    color: var(--text-dim);
    font-size: 0.65rem;
    font-family: var(--font-mono);
    margin-right: 4px;
}

.threat-keyword {
    background: rgba(255, 42, 85, 0.35);
    color: #ffadb9;
    padding: 1px 4px;
    border-radius: 3px;
    font-weight: 700;
}

/* Call Control Toolbar */
.call-controls-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 8px 10px;
    margin-top: 4px;
}

.btn-ctrl {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 0.62rem;
    font-weight: 600;
    transition: all var(--transition-fast);
}

.btn-ctrl .ctrl-icon {
    font-size: 18px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
}

.btn-ctrl:hover .ctrl-icon {
    background: rgba(255, 255, 255, 0.15);
    color: var(--text-main);
}

.btn-ctrl.btn-block .ctrl-icon {
    background: rgba(255, 42, 85, 0.2);
    color: var(--accent-red);
}

.btn-ctrl.btn-hangup .ctrl-icon {
    background: #ef4444;
    color: #ffffff;
    box-shadow: 0 2px 10px rgba(239, 68, 68, 0.4);
}

/* Bottom Navigation Bar */
.mobile-bottom-nav {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 56px;
    background: rgba(9, 14, 26, 0.95);
    backdrop-filter: blur(16px);
    border-top: 1px solid var(--border-subtle);
    display: flex;
    justify-content: space-around;
    align-items: center;
    z-index: 85;
}

.nav-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    background: transparent;
    border: none;
    color: var(--text-dim);
    cursor: pointer;
    font-size: 0.62rem;
    font-weight: 600;
    transition: color var(--transition-fast);
}

.nav-btn .nav-icon {
    font-size: 16px;
}

.nav-btn.active {
    color: var(--accent-emerald);
}

/* ==========================================================================
   Screen 3 & 4: Trusted Circle & Incident Center
   ========================================================================== */
.screen-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.section-subtext {
    font-size: 0.74rem;
    color: var(--text-muted);
    margin-bottom: 14px;
}

.trusted-circle-list, .incidents-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.contact-card, .incident-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 10px 12px;
}

.contact-card {
    display: flex;
    align-items: center;
    gap: 10px;
}

.contact-avatar {
    font-size: 24px;
}

.contact-info {
    flex: 1;
}

.contact-name {
    font-size: 0.84rem;
    font-weight: 700;
}

.contact-meta {
    font-size: 0.7rem;
    color: var(--text-dim);
}

.contact-hash code {
    font-size: 0.65rem;
    color: var(--accent-cyan);
    font-family: var(--font-mono);
}

.contact-badge {
    text-align: right;
}

.badge-pill {
    display: block;
    font-size: 0.62rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
}

.badge-pill.active {
    background: rgba(16, 185, 129, 0.2);
    color: var(--accent-emerald);
}

.freq-tag {
    font-size: 0.62rem;
    color: var(--text-dim);
    font-family: var(--font-mono);
}

/* Incident Cards */
.incident-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.7rem;
    margin-bottom: 6px;
}

.incident-id {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent-cyan);
}

.incident-time {
    color: var(--text-dim);
}

.badge-threat {
    background: rgba(255, 42, 85, 0.2);
    color: var(--accent-red);
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.65rem;
}

.incident-body {
    font-size: 0.74rem;
    color: var(--text-muted);
    line-height: 1.4;
}

.text-danger {
    color: #ff6b8b;
    font-weight: 600;
}

.incident-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 8px;
    padding-top: 6px;
    border-top: 1px solid var(--border-subtle);
}

.compliance-tag {
    font-size: 0.62rem;
    color: var(--accent-cyan);
}

/* Settings */
.settings-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 12px;
}

.settings-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    padding: 12px;
    border-radius: var(--radius-sm);
}

.settings-title {
    font-size: 0.84rem;
    font-weight: 600;
}

.settings-sub {
    font-size: 0.7rem;
    color: var(--text-dim);
}

.range-val {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent-emerald);
    font-weight: 700;
}

/* ==========================================================================
   Enterprise SOC Command Center Styles
   ========================================================================== */
.soc-dashboard-wrapper {
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.soc-header {
    background: var(--bg-surface-glass);
    backdrop-filter: blur(16px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 16px 20px;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.3);
}

.soc-badge {
    font-size: 0.68rem;
    font-weight: 800;
    font-family: var(--font-mono);
    color: var(--accent-cyan);
    letter-spacing: 1.2px;
}

.soc-title h2 {
    font-size: 1.3rem;
    font-weight: 800;
    margin: 2px 0 4px 0;
    background: linear-gradient(90deg, #ffffff, #94a3b8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.soc-meta {
    font-size: 0.74rem;
    font-family: var(--font-mono);
    color: var(--text-dim);
    letter-spacing: 0.5px;
}

.soc-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
}

.soc-card {
    background: var(--bg-surface-glass);
    backdrop-filter: blur(16px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 16px;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.35);
}

.soc-card-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.72rem;
    font-weight: 800;
    font-family: var(--font-mono);
    letter-spacing: 0.8px;
    color: var(--text-dim);
    margin-bottom: 12px;
}

.live-dot {
    background: rgba(255, 42, 85, 0.2);
    color: var(--accent-red);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.62rem;
}

.sample-rate, .nlp-badge {
    font-size: 0.62rem;
    color: var(--accent-emerald);
}

.soc-card canvas {
    width: 100%;
    display: block;
    background: #03060c;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.05);
}

.spectrum-legend {
    display: flex;
    justify-content: space-between;
    font-size: 0.62rem;
    font-family: var(--font-mono);
    color: var(--text-dim);
    margin-top: 6px;
}

/* Metric Rows in SOC */
.metrics-card {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
}

.metric-row {
    margin-bottom: 12px;
}

.metric-row:last-child {
    margin-bottom: 0;
}

.metric-info {
    display: flex;
    justify-content: space-between;
    font-size: 0.78rem;
    margin-bottom: 4px;
    font-weight: 600;
}

.metric-num {
    font-family: var(--font-mono);
    font-weight: 700;
}

.progress-bar-bg {
    width: 100%;
    height: 8px;
    background: #0a1120;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
}

.progress-bar-fill {
    height: 100%;
    border-radius: 4px;
    transition: width 0.4s ease;
}

.fill-red { background: linear-gradient(90deg, #f59e0b, #ff2a55); }
.fill-green { background: linear-gradient(90deg, #10b981, #05f5a1); }
.fill-cyan { background: linear-gradient(90deg, #0ea5e9, #38bdf8); }

/* SOC Transcript */
.soc-transcript-stream {
    height: 120px;
    overflow-y: auto;
    background: #04070e;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    padding: 8px 12px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.soc-line.system {
    color: var(--accent-emerald);
    font-weight: 700;
}

.soc-entity-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
}

.entity-tag {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-size: 0.65rem;
    padding: 3px 8px;
    border-radius: 4px;
    font-family: var(--font-mono);
}

/* ==========================================================================
   Modals & Overlays
   ========================================================================== */
.modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(12px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 200;
}

.modal-overlay.hidden {
    display: none;
}

.modal-box {
    background: #0c1324;
    border: 1px solid var(--border-accent);
    border-radius: var(--radius-md);
    width: 90%;
    max-width: 480px;
    padding: 24px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.7), 0 0 30px rgba(5, 245, 161, 0.2);
    animation: modalPop 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes modalPop {
    from { transform: scale(0.92); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
}

.modal-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
}

.modal-icon {
    font-size: 24px;
}

.modal-header h3 {
    font-size: 1.15rem;
    font-weight: 700;
}

.modal-desc {
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 16px;
}

.challenge-phrase-card {
    background: #050810;
    border: 1px solid var(--accent-emerald);
    border-radius: var(--radius-sm);
    padding: 16px;
    text-align: center;
    margin-bottom: 14px;
}

.phrase-label {
    font-size: 0.65rem;
    color: var(--text-dim);
    font-family: var(--font-mono);
    letter-spacing: 1px;
}

.challenge-phrase {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--accent-emerald);
    margin-top: 4px;
    letter-spacing: 1px;
}

.challenge-status {
    text-align: center;
    font-size: 0.8rem;
    color: var(--accent-cyan);
    font-family: var(--font-mono);
    margin-bottom: 16px;
}

.modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
}

.form-group {
    margin-bottom: 12px;
}

.form-group label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 4px;
}

.form-input {
    width: 100%;
    background: #060a14;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 8px 12px;
    color: var(--text-main);
    font-size: 0.84rem;
    font-family: var(--font-sans);
}

.form-input:focus {
    outline: none;
    border-color: var(--accent-emerald);
    box-shadow: 0 0 8px rgba(5, 245, 161, 0.3);
}

.enroll-audio-sample {
    margin: 16px 0;
    padding: 12px;
    background: rgba(14, 165, 233, 0.08);
    border: 1px dashed rgba(14, 165, 233, 0.3);
    border-radius: var(--radius-sm);
}

.sample-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent-cyan);
    display: block;
    margin-bottom: 6px;
}

/* Responsive Breakpoints */
@media (max-width: 1100px) {
    .app-workspace {
        grid-template-columns: 1fr;
        justify-items: center;
    }
    .soc-dashboard-wrapper {
        width: 100%;
        max-width: 600px;
    }
}

.status-gray { color: #8892b0 !important; }
.banner-gray {
    background: rgba(136, 146, 176, 0.1) !important;
    border-color: rgba(136, 146, 176, 0.3) !important;
    color: #8892b0 !important;
}
.privacy-badge {
    font-size: 0.65rem;
    color: var(--accent-emerald, #05f5a1);
    background: rgba(5, 245, 161, 0.1);
    padding: 3px 8px;
    border-radius: 6px;
    border: 1px solid rgba(5, 245, 161, 0.25);
    display: inline-flex;
    align-items: center;
    gap: 4px;
}
